#include <windows.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_AICHAT_DIALOG DIALOGEX 0, 0, 300, 400
STYLE WS_CHILD | WS_CLIPCHILDREN | WS_CLIPSIBLINGS | DS_CONTROL
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI", 0, 0
BEGIN
    CONTROL     "", IDC_CHAT_EDIT, "LISTBOX",
                WS_VSCROLL | LBS_OWNERDRAWVARIABLE |
                LBS_NOINTEGRALHEIGHT | LBS_NOTIFY,
                4, 4, 292, 246

    LTEXT       "Status:", IDC_STATUS_TEXT, 4, 252, 292, 22,
                SS_SUNKEN

    EDITTEXT    IDC_CHAT_INPUT, 4, 280, 292, 55,
                ES_MULTILINE | WS_VSCROLL | ES_AUTOVSCROLL | ES_WANTRETURN

    PUSHBUTTON  "&Send", IDC_CHAT_SEND, 4, 345, 70, 24,
                BS_PUSHBUTTON

    PUSHBUTTON  "&Clear", IDC_CHAT_CLEAR, 78, 345, 70, 24,
                BS_PUSHBUTTON

    PUSHBUTTON  "&Insert \x25BC", IDC_CHAT_INSERT, 158, 345, 80, 24,
                BS_PUSHBUTTON
END

IDD_VIEWMSG_DIALOG DIALOGEX 0, 0, 450, 350
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MAXIMIZEBOX
CAPTION "Message"
FONT 9, "Segoe UI", 0, 0
BEGIN
    EDITTEXT    IDC_VIEWMSG_TEXT, 8, 8, 434, 304,
                ES_MULTILINE | ES_READONLY | WS_VSCROLL | ES_AUTOVSCROLL |
                ES_AUTOHSCROLL

    DEFPUSHBUTTON "Close", IDOK, 380, 320, 60, 22
END

IDD_AICONFIG_DIALOG DIALOGEX 0, 0, 400, 380
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "AI Chat Configuration"
FONT 9, "Segoe UI", 0, 0
BEGIN
    LTEXT       "API Endpoint:", -1, 10, 10, 120, 10
    EDITTEXT    IDC_CFG_ENDPOINT, 10, 22, 380, 14,
                ES_AUTOHSCROLL

    LTEXT       "Model:", -1, 10, 44, 120, 10
    EDITTEXT    IDC_CFG_MODEL, 10, 56, 380, 14,
                ES_AUTOHSCROLL

    LTEXT       "API Key:", -1, 10, 78, 120, 10
    EDITTEXT    IDC_CFG_APIKEY, 10, 90, 380, 14,
                ES_AUTOHSCROLL | ES_PASSWORD

    LTEXT       "System Prompt:", -1, 10, 112, 120, 10
    EDITTEXT    IDC_CFG_SYSPROMPT, 10, 124, 380, 80,
                ES_MULTILINE | WS_VSCROLL | ES_AUTOVSCROLL

    LTEXT       "Temperature (0.0-2.0):", -1, 10, 216, 120, 10
    EDITTEXT    IDC_CFG_TEMPERATURE, 10, 228, 60, 14,
                ES_AUTOHSCROLL | ES_NUMBER

    LTEXT       "Max Tokens:", -1, 10, 250, 120, 10
    EDITTEXT    IDC_CFG_MAXTOKENS, 10, 262, 80, 14,
                ES_AUTOHSCROLL | ES_NUMBER

    PUSHBUTTON  "OK", IDOK, 230, 340, 70, 24
    PUSHBUTTON  "Cancel", IDCANCEL, 310, 340, 70, 24
END
